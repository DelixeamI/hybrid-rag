# Copy to .env and edit. Nothing here is a secret for tests: tests need no keys.

# Postgres (docker compose)
POSTGRES_USER=tkrag
POSTGRES_PASSWORD=tkrag
POSTGRES_DB=tkrag
PG_PORT=5432
DATABASE_URL=postgresql://tkrag:tkrag@localhost:5432/tkrag

# Models
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Retrieval
# Chosen on the DEV half of the golden set (DESIGN D5). Classic RRF: RRF_K=60, RRF_DENSE_WEIGHT=1
RRF_K=10
RRF_DENSE_WEIGHT=3

# LLM: fake | recorded | openai. Only "openai" needs network and a key (Ollama: http://localhost:11434/v1)
LLM_MODE=recorded
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=your-key-here
